{
  "name": "jsr",
  "version": "1.0.0",
  "private": true,
  "description": "JSR desktop application — offline vendor & sales management",
  "author": "JSR",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "electron": "electron .",
    "electron:dev": "node scripts/electron-dev.cjs",
    "electron:open": "node scripts/electron-open.cjs",
    "electron:start": "npm run build:client && cross-env NODE_ENV=production electron .",
    "mongodb:download": "node scripts/download-mongodb.cjs",
    "mongodb:download:win": "node scripts/download-mongodb.cjs win32",
    "mongodb:download:mac": "node scripts/download-mongodb.cjs darwin",
    "dist:win": "npm run build:client && npm run mongodb:download:win && electron-builder --win nsis --x64",
    "dist:win:portable": "npm run build:client && npm run mongodb:download:win && electron-builder --win portable --x64",
    "dist:win:all": "npm run build:client && npm run mongodb:download:win && electron-builder --win nsis portable --x64",
    "dist:mac": "npm run build:client && npm run mongodb:download:mac && electron-builder --mac",
    "dist": "npm run dist:win"
  },
  "build": {
    "appId": "com.jsr.app",
    "productName": "JSR",
    "copyright": "Copyright © JSR",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          "!.env",
          "!scripts/**",
          "!**/*.md"
        ]
      },
      {
        "from": "client/dist",
        "to": "client/dist"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "JSR-${version}-${os}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "resources/mongodb/win32",
          "to": "mongodb"
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JSR",
      "uninstallDisplayName": "JSR",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "build/license.txt",
      "artifactName": "JSR-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "JSR-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "artifactName": "JSR-${version}.${ext}",
      "extraResources": [
        {
          "from": "resources/mongodb/darwin",
          "to": "mongodb"
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "extraResources": [
        {
          "from": "resources/mongodb/linux",
          "to": "mongodb"
        }
      ],
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.2"
  }
}
